<div class="page-header lookbook-header" style="<%= lookbook.coverImage?.url ? 'background-image: url(' + lookbook.coverImage.url + ')' : '' %>">
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href="/lookbooks">Lookbooks</a></li>
        <li aria-current="page"><%= lookbook.title %></li>
      </ol>
    </nav>
    <h1 class="page-title"><%= lookbook.title %></h1>
    <% if (lookbook.season && lookbook.year) { %>
      <p class="page-subtitle"><%= capitalize(lookbook.season) %> <%= lookbook.year %> Collection</p>
    <% } else if (lookbook.shortDescription) { %>
      <p class="page-subtitle"><%= lookbook.shortDescription %></p>
    <% } %>
  </div>
</div>

<div class="lookbook-detail-page">
  <div class="container">
    <% if (lookbook.description) { %>
      <div class="lookbook-description"><%= lookbook.description %></div>
    <% } %>
    
    <% if (lookbook.images && lookbook.images.length > 0) { %>
      <section class="lookbook-gallery" aria-labelledby="gallery-heading">
        <h2 id="gallery-heading" class="visually-hidden">Lookbook Gallery</h2>
        <div class="gallery-grid" role="list">
          <% lookbook.images.forEach((image, index) => { %>
            <article class="gallery-item" role="listitem">
              <figure>
                <img src="<%= image.url %>" alt="<%= image.alt %>" loading="lazy" width="800" height="1000">
                <% if (image.caption) { %>
                  <figcaption><%= image.caption %></figcaption>
                <% } %>
                <% if (image.product) { %>
                  <a href="/product/<%= image.product.slug %>" class="gallery-product-link" aria-label="Shop <%= image.product.name %>">
                    Shop <%= image.product.name %>
                  </a>
                <% } %>
              </figure>
            </article>
          <% }) %>
        </div>
      </section>
    <% } %>
    
    <% if (lookbook.products && lookbook.products.length > 0) { %>
      <section class="lookbook-products" aria-labelledby="products-heading">
        <h2 id="products-heading" class="section-title">Shop the Look</h2>
        <div class="product-grid" role="list">
          <% lookbook.products.forEach(product => { %>
            <%- include('../partials/product-card', { product }) %>
          <% }) %>
        </div>
      </section>
    <% } %>
  </div>
</div>