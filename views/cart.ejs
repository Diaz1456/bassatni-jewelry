<div class="page-header">
  <div class="container">
    <h1 class="page-title">Shopping Cart</h1>
    <p class="page-subtitle">Your selection of fine jewelry</p>
  </div>
</div>

<section class="cart-page" aria-label="Shopping cart contents">
  <div class="container">
    <div class="cart-layout" data-cart-layout>
      <div class="cart-items-area">
        <div class="cart-items-list" data-cart-items aria-live="polite"></div>

        <div class="cart-empty is-hidden" data-cart-empty>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
            <circle cx="9" cy="21" r="1"/>
            <circle cx="20" cy="21" r="1"/>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
          </svg>
          <p>Your cart is empty.</p>
          <p>Explore our collections to find something you'll treasure.</p>
          <a href="/catalog" class="btn btn-primary" style="margin-top: 1rem;">Shop Jewelry</a>
        </div>
      </div>

      <aside class="cart-summary" aria-label="Order summary" data-cart-summary>
        <h2>Order Summary</h2>
        <div class="summary-row">
          <span class="summary-label">Items</span>
          <span class="summary-value" data-cart-count>0</span>
        </div>
        <div class="summary-row">
          <span class="summary-label">Subtotal</span>
          <span class="summary-value" data-cart-subtotal>&dollar;0.00</span>
        </div>
        <div class="summary-row">
          <span class="summary-label">Shipping</span>
          <span class="summary-value">Complimentary</span>
        </div>
        <div class="summary-row total">
          <span class="summary-label">Estimated Total</span>
          <span class="summary-value" data-cart-total>&dollar;0.00</span>
        </div>
        <button type="button" class="btn btn-primary btn-lg" data-cart-checkout>Proceed to Checkout</button>
        <button type="button" class="btn btn-secondary" data-cart-clear>Clear Cart</button>
        <p class="admin-note" style="margin-top: 0.75rem; text-align: center;">Demo storefront — checkout is not yet enabled. Items are stored in your browser only.</p>
      </aside>
    </div>
  </div>
</section>