<div class="error-page">
  <div class="container">
    <div class="error-content">
      <svg class="error-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <circle cx="12" cy="12" r="10"/>
        <line x1="12" y1="8" x2="12" y2="12"/>
        <line x1="12" y1="16" x2="12.01" y2="16"/>
      </svg>
      <h1><%= message || 'Something went wrong' %></h1>
      <p><%= typeof statusCode !== 'undefined' && Number(statusCode) === 404 ? 'The page you are looking for does not exist or has been moved.' : 'Please try again later or contact support if the problem persists.' %></p>
      <div class="error-actions">
        <a href="/" class="btn btn-primary">Return Home</a>
        <a href="/catalog" class="btn btn-secondary">Browse Catalog</a>
      </div>
    </div>
  </div>
</div>