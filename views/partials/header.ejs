<% const shopActive = currentPath === '/' || currentPath === '/shop' || currentPath === '/catalog' || currentPath.startsWith('/catalog/') || currentPath.startsWith('/product') || currentPath.startsWith('/category') || currentPath === '/categories'; %>
<header class="site-header" role="banner">
  <div class="header-top">
    <div class="container">
      <div class="announcement-bar" aria-live="polite">
        <% if (!settings || !settings.announcementBar || settings.announcementBar.enabled !== false) { %>
          <span><%= settings && settings.announcementBar && settings.announcementBar.text ? settings.announcementBar.text : 'Complimentary shipping on all orders over $500' %></span>
        <% } %>
      </div>
    </div>
  </div>

  <div class="header-main">
    <div class="container">
      <div class="header-left">
        <button class="mobile-menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="main-nav">
          <span class="hamburger"></span>
        </button>

        <a href="/" class="logo" aria-label="<%= config.name %> - Home">
          <span class="logo-text shop-name"><%= config.name %></span>
        </a>
      </div>

      <nav id="main-nav" class="main-nav" role="navigation" aria-label="Main navigation">
        <ul class="nav-list">
          <li class="nav-item">
            <a href="/" class="nav-link <%= shopActive ? 'is-active' : '' %>">Shop</a>
          </li>

          <li class="nav-item">
            <a href="/contact" class="nav-link <%= currentPath === '/contact' ? 'is-active' : '' %>">Contact</a>
          </li>

          <% if (isAdminLoggedIn) { %>
            <li class="nav-item">
              <a href="/admin" class="nav-link">Dashboard</a>
            </li>
            <li class="nav-item">
              <form method="post" action="/admin/logout" class="nav-logout-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="nav-link nav-link--btn" aria-label="Log out of admin">Logout</button>
              </form>
            </li>
          <% } else { %>
            <li class="nav-item">
              <a href="/admin" class="nav-link nav-link--admin">Admin Login</a>
            </li>
          <% } %>
        </ul>
      </nav>

      <div class="header-right">
        <a href="/cart" class="header-icon cart-link" aria-label="Shopping cart (0 items)">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <circle cx="9" cy="21" r="1"/>
            <circle cx="20" cy="21" r="1"/>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
          </svg>
          <span class="cart-count" aria-live="polite">0</span>
        </a>
      </div>
    </div>
  </div>

  <div class="mobile-nav-overlay" aria-hidden="true"></div>
</header>