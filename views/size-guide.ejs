<div class="page-header">
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li aria-current="page">Size Guide</li>
      </ol>
    </nav>
    <h1 class="page-title">Jewelry Size Guide</h1>
    <p class="page-subtitle">Finding the perfect fit, thoughtfully</p>
  </div>
