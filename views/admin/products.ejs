<div class="admin-toolbar">
  <form method="get" action="/admin/products" class="admin-product-filters">
    <input type="search" name="q" value="<%= q %>" placeholder="Search by name or SKU…">
    <select name="category">
      <option value="">All categories</option>
      <% categories.forEach(cat => { %>
        <option value="<%= cat._id %>" <%= category === String(cat._id) ? 'selected' : '' %>><%= cat.name %></option>
      <% }) %>
    </select>
    <select name="status">
      <option value="show" <%= status === 'show' ? 'selected' : '' %>>All live</option>
      <option value="active" <%= status === 'active' ? 'selected' : '' %>>Active</option>
      <option value="inactive" <%= status === 'inactive' ? 'selected' : '' %>>Inactive</option>
      <option value="deleted" <%= status === 'deleted' ? 'selected' : '' %>>Trash</option>
    </select>
    <select name="sort">
      <option value="-createdAt" <%= sortBy === '-createdAt' ? 'selected' : '' %>>Newest first</option>
      <option value="createdAt" <%= sortBy === 'createdAt' ? 'selected' : '' %>>Oldest first</option>
      <option value="name" <%= sortBy === 'name' ? 'selected' : '' %>>Name A–Z</option>
      <option value="-name" <%= sortBy === '-name' ? 'selected' : '' %>>Name Z–A</option>
      <option value="price" <%= sortBy === 'price' ? 'selected' : '' %>>Price low–high</option>
      <option value="-price" <%= sortBy === '-price' ? 'selected' : '' %>>Price high–low</option>
      <option value="-soldCount" <%= sortBy === '-soldCount' ? 'selected' : '' %>>Best sellers</option>
    </select>
    <button type="submit" class="admin-btn">Apply</button>
    <% if (q || category || status !== 'show' || sortBy !== '-createdAt') { %>
      <a href="/admin/products" class="admin-btn admin-btn--ghost">Reset</a>
    <% } %>
  </form>
  <a class="admin-btn admin-btn--primary" href="/admin/products/new">⊕ Add New Product</a>
</div>

<form method="post" action="/admin/products/bulk" id="bulk-products-form" data-bulk-select>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="admin-bulk-bar">
    <span><strong>Select:</strong>
      <button type="button" class="admin-link" data-check-all>All</button>
      <button type="button" class="admin-link" data-check-none>None</button>
    </span>
    <span>With selected:
      <select name="action">
        <option value="activate">Activate</option>
        <option value="hide">Hide</option>
        <option value="trash">Move to trash</option>
      </select>
      <button type="submit" class="admin-btn admin-btn--sm" data-bulk-submit>Apply</button>
    </span>
  </div>

  <div class="admin-table-wrap">
    <table class="admin-table">
      <thead>
        <tr>
          <th class="admin-tcol-check">
            <label><input type="checkbox" data-check-toggle aria-label="Select all products"> <span class="visually-hidden">All</span></label>
          </th>
          <th>Image</th>
          <th>Name</th>
          <th>SKU</th>
          <th>Price</th>
          <th>Category</th>
          <th>Stock</th>
          <th>Flags</th>
          <th>Status</th>
          <th class="admin-tcol-actions">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (!products.length) { %>
          <tr><td colspan="10" class="admin-empty">
            <%= (q || category || status !== 'show') ? 'No products match your filters.' : 'No products yet.' %>
            <a href="/admin/products/new">Add your first product →</a>
          </td></tr>
        <% } %>
        <% products.forEach(product => { %>
          <tr class="<%= product.status === 'deleted' ? 'admin-row-deleted' : '' %>">
            <td>
              <label><input type="checkbox" name="ids" value="<%= product._id %>" aria-label="Select <%= product.name %>"></label>
            </td>
            <td><img class="admin-thumb" src="<%= product.mainImage?.url || '/images/placeholder.svg' %>" alt=""></td>
            <td class="admin-cell-name">
              <a href="/admin/products/<%= product._id %>/edit"><%= product.name %></a>
              <a class="admin-cell-preview" href="/product/<%= product.slug %>" target="_blank" rel="noopener">View ↗</a>
            </td>
            <td><%= product.sku %></td>
            <td><%= formatPrice(product.price) %><% if (product.compareAtPrice) { %> <del class="admin-muted"><%= formatPrice(product.compareAtPrice) %></del><% } %></td>
            <td><%= product.category ? product.category.name : '—' %></td>
            <td>
              <% if (product.inStock) { %><span class="admin-badge admin-badge--ok">In stock (<%= product.stockQuantity %>)</span>
              <% } else { %><span class="admin-badge admin-badge--danger">Out of stock</span><% } %>
            </td>
            <td class="admin-flags">
              <% if (product.isNew) { %><span class="admin-badge">New</span><% } %>
              <% if (product.isBestSeller) { %><span class="admin-badge admin-badge--gold">Best Seller</span><% } %>
              <% if (!product.isActive) { %><span class="admin-badge admin-badge--danger">Hidden</span><% } %>
            </td>
            <td>
              <% if (product.status === 'deleted') { %><span class="admin-badge admin-badge--danger">Trashed</span>
              <% } else if (product.status === 'inactive') { %><span class="admin-badge">Inactive</span>
              <% } else { %><span class="admin-badge admin-badge--ok">Active</span><% } %>
            </td>
            <td class="admin-tcol-actions">
              <div class="admin-row-actions">
                <% if (product.status === 'deleted') { %>
                  <form method="post" action="/admin/products/<%= product._id %>/restore">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="admin-btn admin-btn--sm">Restore</button>
                  </form>
                  <form method="post" action="/admin/products/<%= product._id %>/purge" class="admin-delete-form" data-confirm="Permanently delete '<%= product.name %>' and its images? This cannot be undone.">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="admin-btn admin-btn--sm admin-btn--danger">Purge</button>
                  </form>
                <% } else { %>
                  <a class="admin-btn admin-btn--sm" href="/admin/products/<%= product._id %>/edit">Edit</a>
                  <form method="post" action="/admin/products/<%= product._id %>/delete" class="admin-delete-form" data-confirm="Move '<%= product.name %>' to trash? You can restore it later from the Trash filter.">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="admin-btn admin-btn--sm admin-btn--danger">Trash</button>
                  </form>
                <% } %>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</form>

<% if (pagination.pages > 1) { %>
  <nav class="admin-pagination" aria-label="Product pagination">
    <% for (let i = 1; i <= pagination.pages; i++) { %>
      <% if (i === pagination.page) { %>
        <span class="admin-page admin-page--current"><%= i %></span>
      <% } else { %>
        <a class="admin-page" href="<%= buildQuery({ page: i }) %>"><%= i %></a>
      <% } %>
    <% } %>
  </nav>
<% } %>