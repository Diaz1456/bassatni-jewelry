<div class="admin-panel">
  <h2 class="admin-panel-title">Change Password</h2>
  <p class="admin-muted">Choose a strong password you don't use anywhere else. You'll stay signed in after the update.</p>

  <form method="post" action="/admin/change-password" class="admin-form" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="admin-grid">
      <div class="admin-field admin-field--wide">
        <label for="currentPassword">Current password <span class="req">*</span></label>
        <input id="currentPassword" name="currentPassword" type="password" required autocomplete="current-password" placeholder="••••••••">
        <% if (errors.currentPassword) { %><span class="admin-error"><%= errors.currentPassword %></span><% } %>
      </div>

      <div class="admin-field">
        <label for="newPassword">New password <span class="req">*</span></label>
        <input id="newPassword" name="newPassword" type="password" required minlength="8" autocomplete="new-password" placeholder="At least 8 characters">
        <% if (errors.newPassword) { %><span class="admin-error"><%= errors.newPassword %></span><% } %>
      </div>

      <div class="admin-field">
        <label for="confirmPassword">Confirm new password <span class="req">*</span></label>
        <input id="confirmPassword" name="confirmPassword" type="password" required minlength="8" autocomplete="new-password" placeholder="Repeat new password">
        <% if (errors.confirmPassword) { %><span class="admin-error"><%= errors.confirmPassword %></span><% } %>
      </div>
    </div>

    <div class="admin-form-actions">
      <button type="submit" class="admin-btn admin-btn--primary admin-btn--lg">Update password</button>
      <a href="/admin" class="admin-btn admin-btn--lg">Cancel</a>
    </div>
  </form>
</div>