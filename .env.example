# ─────────────────────────────────────────────────────────────
# Elegance Jewelry — environment configuration
# Copy this file to `.env` and adjust for your environment.
# ─────────────────────────────────────────────────────────────

# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Configuration
# Use your Atlas URI in production (user:password encoded).
MONGODB_URI=mongodb://localhost:27017/jewelry-shop
# Optional: set only if you want a different URI for NODE_ENV=production.
# When unset, MONGODB_URI is used for every environment (recommended).
MONGODB_URI_PROD=

# Session Secret — REQUIRED in production. Generate with: openssl rand -hex 32
SESSION_SECRET=your-super-secret-session-key-change-in-production

# Google Analytics (optional)
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Site Configuration
SITE_URL=http://localhost:3000
SITE_NAME="Elegance Jewelry"
SITE_DESCRIPTION="Exquisite fine jewelry for life's precious moments"

# Image Optimization
IMAGE_QUALITY=80
IMAGE_MAX_WIDTH=1920

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Admin account — used by `npm run seed` to create the initial admin user.
# Defaults below match the seeded credentials.
ADMIN_EMAIL=admin@jewelrystore.com
ADMIN_PASSWORD=admin123
ADMIN_NAME="Store Owner"

# Site settings cache lifetime (ms) — how long the public site caches the
# shop name/logo/hero loaded from MongoDB between admin edits.
SETTINGS_CACHE_TTL_MS=60000